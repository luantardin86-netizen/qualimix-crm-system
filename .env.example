# Chaves públicas da Data API; não substituem a autenticação própria do servidor.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Credenciais exclusivas do servidor PostgreSQL.
# Use a conexão do papel qualimix_app; nunca use prefixo VITE_.
DATABASE_URL=
# Certificado raiz CA do Supabase em Base64 (PEM completo).
SUPABASE_CA_CERT_BASE64=

# Upload do logo institucional (somente servidor; nunca use prefixo VITE_).
# Use a mesma URL de VITE_SUPABASE_URL e uma chave secreta sb_secret_ do Supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
